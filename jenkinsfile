pipeline {
    agent any

    environment {
        PYTHON = 'C:\\Users\\jaydi\\AppData\\Local\\Programs\\Python\\Python313\\python.exe'
        PATH = "C:\\Users\\jaydi\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
    }

    stages {
        stage('Install Dependencies') {
            steps {
                bat '"%PYTHON%" -m pip install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                bat '"%PYTHON%" -m pytest'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t online-book-store:jenkins .'
            }
        }
    }
}